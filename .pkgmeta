# BigWigs packager: the zip is the addon folder "WandererMail", the changelog of the version is CHANGELOG.md
# (written at each release from the full changelog).
package-as: WandererMail

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Mail needs Wanderer.
required-dependencies:
  - wanderer
